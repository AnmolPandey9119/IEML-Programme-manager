# Local development uses SQLite. In production (Render) set DATABASE_URL to your Neon / Postgres URL.
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
INVITE_EXPIRE_DAYS=7
# The address people open in the browser (your Vercel URL in production). Used in invite links.
FRONTEND_URL=http://localhost:8000
# Event days are calendar dates; the "within 48 hours" late-change rule is measured in this timezone
EVENT_TIMEZONE=Asia/Kolkata
MAX_PHOTO_MB=5